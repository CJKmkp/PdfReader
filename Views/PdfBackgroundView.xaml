<UserControl x:Class="PdfReader.Views.PdfBackgroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1E1E1E"
             ClipToBounds="True">
    <!-- 连续滚动长条：所有页垂直排列，页间留空白带。滚动通过 StripTransform.TranslateY 实现。 -->
    <Canvas x:Name="Strip" Background="#FF1E1E1E" ClipToBounds="True"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Canvas.RenderTransform>
            <TranslateTransform x:Name="StripTransform" />
        </Canvas.RenderTransform>
    </Canvas>
</UserControl>
